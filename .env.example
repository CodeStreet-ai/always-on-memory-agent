# Azure OpenAI configuration for the always-on memory agent.
# Copy this file to `.env` and fill in your resource values.
# `python-dotenv` loads `.env` automatically when you run `python agent.py`.

# Resource URL of your Azure OpenAI deployment (the "/openai" suffix is added automatically)
AZURE_OPENAI_ENDPOINT=https://intelli-dev-foundry-prj-resource.openai.azure.com

# Deployment (model) name on your Azure OpenAI resource
MODEL=gpt-4.1

# API version for the OpenAI Responses API
OPENAI_API_VERSION=2025-03-01-preview

# Your Azure OpenAI resource API key (KEEP SECRET — do not commit .env)
AZURE_OPENAI_API_KEY=
